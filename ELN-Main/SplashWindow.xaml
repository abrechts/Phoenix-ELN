<Window x:Class="SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phoenix ELN" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        Width="320" Height="140" AllowsTransparency="False">

    <!--Merges a private copy of SkinDark.xaml into this window's own Resources (not the shared
    Application.Resources) so the DynamicResource bindings below can safely stay in sync with the
    real skin colors. This window runs on its own thread (see Application.xaml.vb) so it can keep
    its marquee animating smoothly while MainWindow's constructor blocks the main UI thread; binding
    to Application.Resources instead would be a genuine cross-thread hazard, since DarkModeHelper.
    ApplySkin mutates that shared dictionary from the main thread while this window's bindings are
    still alive and listening on a different thread's Dispatcher. Always dark, deliberately - by the
    time this window exists, MainWindow hasn't yet read the user's saved light/dark preference.-->
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CustomControls;component/Resources/SkinDark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" Margin="24,-14,24,0">
            <DockPanel>
                <TextBlock x:Name="txtVersion" DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="8,0,0,3"
                           FontSize="11" FontFamily="Segoe UI" Foreground="{DynamicResource MutedForeground}" Opacity="0.8"/>
                <TextBlock Text="Phoenix ELN" FontSize="20" FontFamily="Segoe UI" Foreground="{DynamicResource LinkForeground}"/>
            </DockPanel>
            <TextBlock Text="Preparing your experiments ..." FontSize="12" FontFamily="Segoe UI" Margin="0,8,0,0"
                       Foreground="{DynamicResource MutedForeground}" Opacity="0.8"/>

            <!--Custom marquee instead of ProgressBar's IsIndeterminate: MainWindow's constructor blocks
            the main UI thread for its whole synchronous startup, and this window's separate thread is
            what keeps the marquee animating through that (see the note in Application.xaml.vb - a
            same-thread Storyboard animation was verified to freeze solid for the entire blocking
            stretch, regardless of which properties it animated).
            Track and thumb are siblings (not parent/child) so the track's reduced opacity doesn't
            also fade the thumb riding on top of it.-->
            
            <Grid Height="4" ClipToBounds="True" Margin="0,14,0,0">
                <Border Background="{DynamicResource PanelBorder}" CornerRadius="2" Opacity="0.3"/>
                <Border x:Name="pnlProgressThumb" Width="90" CornerRadius="2" HorizontalAlignment="Left"
                        Background="{DynamicResource LinkForeground}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="progressThumbTransform" X="-90"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="progressThumbTransform" Storyboard.TargetProperty="X"
                                                      From="-90" To="272" Duration="0:0:1.1" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
            </Grid>

        </StackPanel>
    </Border>

</Window>
