<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>  
    <AssemblyVersion>$(PackageVersion)</AssemblyVersion>
    <FileVersion>$(PackageVersion)</FileVersion>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>  
    <RootNamespace>ChemBytes</RootNamespace>
    <UseWPF>true</UseWPF>
    <ImportedNamespaces>Spire=False,Spire.License=False,System.IO=False,System.Linq.Experessions=False,System.Windows=False,System.Windows.Controls=False,System.Windows.Data=False,System.Windows.Documents=False,System.Windows.Input=False,System.Windows.Media=False,System.Windows.Media.Imaging=False,System.Windows.Navigation=False,System.Windows.Shapes=False,System.XML=False,Microsoft.VisualBasic=True,System=True,System.Collections=True,System.Collections.Generic=True,System.Diagnostics=True,System.Linq=True,System.Xml.Linq=True,System.Threading.Tasks=True,ELN_Main=True</ImportedNamespaces>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ApplicationManifest>My Project\app.manifest</ApplicationManifest>
    <PackageId>$(AssemblyName)</PackageId>
    <AssemblyName>PhoenixELN</AssemblyName>
    <ApplicationIcon>Resources\Application.ico</ApplicationIcon>
    <Version>5.2.1.0</Version>
    <Copyright>(c) Stefan Abrecht, ChemBytes</Copyright>
    <PackageProjectUrl></PackageProjectUrl>
    <StartupObject>Sub Main</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Page Remove="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- TEMPORARY Microsoft-provided workaround for the WPF XPS font-subsetting FileFormatException
         thrown on the current variable-font build of CALIBRI.TTF (and similar) when exporting/
         printing to PDF. See PaginatorToPdfDoc in ExperimentPrint.vb.
         This switch disables an overflow-protection check in WPF's TrueType cmap/sbit table
         parser (added as a security hardening mitigation), so it trades away some defense-in-
         depth against malformed/malicious font files in exchange for the fix. Microsoft's own
         guidance frames this as a stopgap pending a proper fix in a future WPF/.NET servicing
         update - once available, remove this switch and re-test PDF export. -->
    <RuntimeHostConfigurationOption Include="Switch.MS.Internal.TtfDelta.DisableCmapAndSbitOverflowProtection" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Application.ico" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System.IO" />
    <Import Include="System.Windows" />
    <Import Include="System.Windows.Controls" />
    <Import Include="System.Windows.Data" />
    <Import Include="System.Windows.Documents" />
    <Import Include="System.Windows.Input" />
    <Import Include="System.Windows.Media" />
    <Import Include="System.Windows.Media.Imaging" />
    <Import Include="System.Windows.Navigation" />
    <Import Include="System.Windows.Shapes" />
    <Import Include="System.XML" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CustomControls\CustomControls.vbproj" />
    <ProjectReference Include="..\ElnBase\ElnBase.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ChemBytesDraw">
      <HintPath>..\References\ChemBytesDraw.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="dlgChangeUsername.xaml.vb">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="My Project\Resources.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="My Project\Settings.Designer.vb">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="My Project\Resources.resx">
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="ElnData_Seed.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="libinchi.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="My Project\Settings.settings">
      <CustomToolNamespace>My</CustomToolNamespace>
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
