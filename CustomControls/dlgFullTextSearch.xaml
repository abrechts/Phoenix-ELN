<Window x:Class="dlgFullTextSearch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomControls"
        mc:Ignorable="d"
        Title="Full-Text Search" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True"
        Height="550" MinHeight="350" Width="490" MinWidth="450" MaxWidth="500" Background="#FF303036">

    <Window.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <!--This window is always dark regardless of the active app skin.-->
                <ResourceDictionary Source="/CustomControls;component/Resources/SkinDark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:StringToVisibilityConverter x:Key="stringToVisConv"/>

            <DataTemplate x:Key="expResultItem">
                <StackPanel Margin="0,2" HorizontalAlignment="Stretch">
                    <local:ExpTreeHeader DataContext="{Binding Experiment}"/>
                    <Separator Background="LightGray" Height="0.9" Margin="16,1,0,4" Opacity="0.4"/>
                    <local:HighlightedSnippetView Margin="18,0,0,0" HorizontalAlignment="Stretch" FontSize="11.5" Opacity="0.85"
                        Foreground="{DynamicResource BodyForeground}"
                        SnapsToDevicePixels="True"
                        Text="{Binding Snippet}"/>
                    <TextBlock Margin="18,1,0,0" FontSize="10.5" FontStyle="Italic" Opacity="0.6"
                        Foreground="{DynamicResource BodyForeground}"
                        Text="{Binding MoreHitsLabel}"
                        Visibility="{Binding MoreHitsLabel, Converter={StaticResource stringToVisConv}}"/>
                </StackPanel>
            </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20,14,20,8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="center">
                    <TextBlock Text="Full-Text Search" FontWeight="Bold" HorizontalAlignment="Center" FontSize="14" Foreground="LightBlue"/>
                    <ContentControl x:Name="icoInfo" Content="{StaticResource icoInfo}" Cursor="Hand" Height="14" Margin="6,2,1,0" Opacity="0.9"/>
                </StackPanel>
                <CheckBox x:Name="chkServerSearch" Content="Server Search" Foreground="White" VerticalAlignment="Center" Margin="0,2,2,0" 
                   FontSize="11.5" HorizontalAlignment="Right"/>
            </Grid>

            <Separator Margin="0,8,0,8" Height="0.9"/>

            <TextBlock TextWrapping="Wrap" Margin="0,2,0,2" Foreground="lightgray" Text="Find text within all finalized experiments (local or server):"/>

            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSearchTerm" Grid.Column="0" VerticalContentAlignment="Center" FontSize="13" VerticalAlignment="Center" Padding="2,1,5,2"
                    d:Text="Allyl"/>
                <Button x:Name="btnRunSearch" Grid.Column="1" HorizontalAlignment="right" Content="Search" Padding="14,4" Margin="8,0,0,0" IsDefault="True"/>
            </Grid>

            <Separator Margin="0,6,0,6" Height="0.9"/>

        </StackPanel>
        
        <ListBox x:Name="lstResults" Grid.Row="1" Background="Transparent" BorderThickness="0" local:DarkModeHelper.IsDarkMode="True"
            HorizontalContentAlignment="Stretch"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="False"
            ItemTemplate="{StaticResource expResultItem}" Padding="0,0,0,4"/>

        <StackPanel Grid.Row="2" >
            <Separator Margin="0,4,0,4" Height="0.9"/>
            <TextBlock x:Name="blkHitInfo" HorizontalAlignment="Center" Foreground="lightblue"/>
        </StackPanel>
        
    </Grid>

</Window>
