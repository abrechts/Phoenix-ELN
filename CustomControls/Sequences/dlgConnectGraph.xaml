<Window x:Class="dlgConnectGraph"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CustomControls" xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d" 
        Title="Connection Graph Visualizer"
        Width="1000" Height="700" MinWidth="800" MinHeight="460" Background="#FF1F1F1F"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" ShowInTaskbar="False"  KeyDown="Window_KeyDown" Opacity="0.95">

    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition x:Name="GraphAreaRow" MinHeight="180"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Vertical separator between reaction scheme area and sidebar -->
        <Rectangle Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right" Width="1" Fill="DimGray" IsHitTestVisible="False"/>

        <!-- SIDEBAR -->

        <Border Grid.Row="2" Grid.Column="1" Background="transparent" BorderBrush="#1E1E42" BorderThickness="0,0,1,0">
            
            <DockPanel LastChildFill="True">

                <!-- Logo / header -->

                <TextBlock x:Name="blkStepPath" DockPanel.Dock="Top" FontSize="12" FontWeight="Bold"
                   FontFamily="Segoe UI" Foreground="#FF98BCFF" Background="transparent" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Run x:Name="runSchemePath" d:Text="Sequence 1"/>
                    <Run Text=">"/>
                    <Run x:Name="runStepNumber" d:Text="Step 2" Foreground="#FFDDD9D9"/>
                </TextBlock>

                <Separator DockPanel.Dock="top" Margin="4,2,4,4"/>

                <!-- Scrollable content area -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource DarkScrollViewerStyle}">
                    
                    <StackPanel Margin="6,2,6,8">
                        
                        <!-- ── Seed picker ── -->
                        <StackPanel x:Name="pnlSeedSelector" Margin="0,0,0,4" Visibility="Collapsed">
                            <TextBlock Text="SEED OBJECT" Foreground="whitesmoke" Margin="2,2,0,6"/>
                            <ComboBox x:Name="SeedComboBox" Style="{StaticResource DarkCombo}"/>
                        </StackPanel>

                        <local:StepExpSelector x:Name="stepExpItems" Opacity="0.95" />

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- GRAPH AREA - spans the full window width -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,6,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="SYNTHETIC CONNECTIONS" FontSize="15" FontWeight="Bold" FontFamily="Segoe UI" 
                        Foreground="#FFF9D192"  HorizontalAlignment="Center" Margin="8,6,0,0" />
                    <TextBlock x:Name="icoInfo" Text="🛈" Cursor="Hand" Foreground="lightblue" Margin="6,6,0,0" VerticalAlignment="Center" FontSize="15"/>
                </StackPanel>

                <TextBlock x:Name="blkSubtitle" Grid.Row="0" Foreground="LightBlue" HorizontalAlignment="center" FontSize="11" Margin="0,0,0,2" Padding="4,0">     
                      <Run Text="➤ "/>
                      <Run x:Name="lnkRefExp" d:Text="testExp-000012"/>
                      <Run Text=" ➤"/>
                </TextBlock>

            </StackPanel>

            <ComboBox x:Name="cboSourceSelection" Grid.Row="0" Style="{StaticResource DarkCombo}" Background="transparent" Margin="0,8,6,0"
               Foreground="#FFB8B9FE" HorizontalAlignment="Right" d:SelectedIndex="0" FontSize="11.5" BorderThickness="1" VerticalAlignment="Center">
                <ComboBoxItem x:Name="cboItemLocal" Content="Local Database"/>
                <ComboBoxItem x:Name="cboItemServer" Content="Server Database"/>
            </ComboBox>

            <local:SequenceGraph x:Name="GraphView" Grid.Row="1" Margin="4,6,4,4" Opacity="0.9"/>

            <!-- Structure graph button -->
            <Button x:Name="btnShowAllSchemes" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center"
               Margin="12,0,0,0" Padding="4,2,6,2" BorderThickness="1"  BorderBrush="#FF036582"  Cursor="Hand" Style="{StaticResource DarkModeButtonStyle}"
               ToolTip="Displays all structures of the &#x0a;complete connection graph &#x0a;(full screen).">
                <TextBlock Text="> Structure Graph " FontSize="12" Foreground="#FFE3E1E1" Margin="0,0,0,2"/>
            </Button>

        </Grid>

        <GridSplitter x:Name="pnlSplitter" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows"
             ResizeBehavior="PreviousAndNext" ShowsPreview="false" Cursor="SizeNS" Background="Transparent"
             BorderBrush="#FF7F7E7E" BorderThickness="0,1,0,0"/>

        <!-- Info toast – floats centered over the whole dialog, auto-dismissed from code-behind -->
        <local:InfoToast x:Name="infoToast" Grid.RowSpan="3" Panel.ZIndex="99"
                         IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Reaction scheme area -->
        <DockPanel Grid.Row="2" Grid.Column="0" Margin="4,8,4,4">

            <Grid DockPanel.Dock="Top" Margin="0,6,0,24">

                <!-- Color legend -->
                <Border x:Name="pnlLegend" HorizontalAlignment="Left" Margin="6,0,0,0" BorderThickness="0" Background="#FF393939" 
                  ToolTipService.InitialShowDelay="500">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="bdrLegendSwatch" Width="10" Height="10" CornerRadius="2" Margin="6,0,4,0" VerticalAlignment="Center" 
                           d:Background="#5284E4"/>
                        <TextBlock x:Name="blkLegendType" FontSize="11" FontFamily="Segoe UI" Foreground="LightGray" VerticalAlignment="Center"
                          d:Text="Linear" Margin="0,0,6,1"/>
                    </StackPanel>
                </Border>

                <!-- Sequence title -->
                <Border x:Name="bdrSchemeTitle" CornerRadius="6" BorderThickness="1" Opacity="1" Padding="8,1,8,4" MinWidth="120"
                   HorizontalAlignment="Center" VerticalAlignment="Center" d:Background="#5284E4" >
                    <TextBlock x:Name="blkSchemeTitle" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI"
                      Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" d:Text="Sequence 1"/>
                </Border>
                
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Visible" Style="{StaticResource DarkScrollViewerStyle}">
                <WrapPanel x:Name="pnlSeqStructures" d:Height="80" HorizontalAlignment="Center"/>
            </ScrollViewer>

        </DockPanel>

    </Grid>
</Window>
