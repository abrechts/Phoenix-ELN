<UserControl x:Class="SequenceGraph"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:sys="clr-namespace:System;assembly=mscorlib"
            mc:Ignorable="d" 
            Background="Transparent" d:Width="600" d:Height="150" >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--This panel is always dark regardless of the active app skin -->
                <ResourceDictionary Source="/CustomControls;component/Resources/SkinDark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ── Scrollbar track ── -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="#0D0D22"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>

        <ScrollViewer x:Name="GraphScroll"
                      Style="{StaticResource SkinScrollViewerStyle}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="Transparent"
                      PanningMode="Both"
                      PreviewMouseWheel="GraphScroll_PreviewMouseWheel"
                      SizeChanged="GraphScroll_SizeChanged">

            <ScrollViewer.Resources>
                <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">10</sys:Double>
                <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">10</sys:Double>
            </ScrollViewer.Resources>

            <Canvas x:Name="GraphCanvas" Background="Transparent"/>

        </ScrollViewer>

        <!-- Zoom control strip (bottom-right, always on top) -->

        <ComboBox x:Name="ZoomCombo"
                    Margin="0,0,4,4"
                    FontSize="11"
                    Tag="100%"
                    VerticalAlignment="Bottom"
                    VerticalContentAlignment="Center"
                    BorderBrush="dimgray"
                    Foreground="#FFBCB8B8"
                    HorizontalAlignment="Right"
                    Style="{StaticResource DarkCombo}"
                    SelectionChanged="ZoomCombo_SelectionChanged">
            <ComboBoxItem Content="100%" IsSelected="True"/>
            <ComboBoxItem Content="75%"/>
            <ComboBoxItem Content="50%"/>
            <ComboBoxItem x:Name="FitAllItem" Content="Fit All"/>
        </ComboBox>

    </Grid>
    
</UserControl>
