<Window x:Class="dlgTags"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CustomControls"
        xmlns:base="clr-namespace:ElnCoreModel;assembly=ElnCoreModel"
        Title="Manage Tags" Height="420" Width="320" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}">

    <Window.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <!--This window is always dark regardless of the active app skin (same convention as
                    dlgSearch/dlgFullTextSearch) - merging SkinDark.xaml here pins every DynamicResource
                    skin key used below to its fixed dark value, taking precedence over whichever skin
                    is active app-wide.-->
                <ResourceDictionary Source="/CustomControls;component/Resources/SkinDark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:IntegerToVisibilityConverter x:Key="integerToVisConv"/>
            <local:BooleanToVisibilityConverter x:Key="boolToVisConv"/>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10,8,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Add / rename row: selecting a tag below switches this into rename mode.-->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="btnAddTag" Content="Add" DockPanel.Dock="Right" Padding="8,1" Margin="6,0,0,0"
                Click="btnAddTag_Click" IsDefault="True"/>
            <TextBox x:Name="txtTagName" MaxLength="50" VerticalContentAlignment="Center"
                Background="{DynamicResource InputBackground}" Foreground="{DynamicResource BodyForeground}"/>
        </DockPanel>

        <Grid Grid.Row="1">

            <ListBox x:Name="lstTags" SelectionMode="Single" SelectionChanged="lstTags_SelectionChanged"
                Background="{DynamicResource InnerPanelBackground}" BorderBrush="{DynamicResource PanelBorder}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsAssigned}" VerticalAlignment="Center" Margin="0,0,6,0"
                                Visibility="{Binding ShowCheckbox, Converter={StaticResource boolToVisConv}}"
                                Checked="chkAssignTag_Checked" Unchecked="chkAssignTag_Unchecked" ToolTip="Assign to the current experiment"/>

                            <!--Same pill styling as the chips in StepSummary's Exp. Info panel.-->
                            <Border Grid.Column="1" Background="#334D84D7" BorderBrush="#FF4D84D7" BorderThickness="1" CornerRadius="9"
                                Padding="6,1,3,1" Margin="0,0,4,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Tag.TagName}" VerticalAlignment="Center" Foreground="{DynamicResource BodyForeground}"/>
                                    <TextBlock Text="{Binding Tag.tblExperimentTags.Count, StringFormat=' ({0})'}"
                                        Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                </StackPanel>
                            </Border>

                            <Button Grid.Column="2" Width="18" Height="18" Padding="0" Background="Transparent" BorderThickness="0"
                                Click="btnDeleteTag_Click" ToolTip="Delete this tag">
                                <TextBlock Text="&#xD7;" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BodyForeground}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="- no tags defined -" HorizontalAlignment="Center" VerticalAlignment="Top" FontStyle="Italic"
                Foreground="{DynamicResource MutedForeground}"
                Visibility="{Binding ElementName=lstTags, Path=Items.Count, Converter={StaticResource integerToVisConv}, ConverterParameter=invert}" Margin="0,64,0,0"/>

        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnClose" Content="Close" IsCancel="True" Padding="16,1" Click="btnClose_Click"/>
        </StackPanel>

    </Grid>
</Window>
