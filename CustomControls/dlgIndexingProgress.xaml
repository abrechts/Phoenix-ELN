<Window x:Class="dlgIndexingProgress"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Phoenix ELN" Width="320" ShowInTaskbar="False" ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen" SizeToContent="Height" Cursor="Wait"
    Background="{DynamicResource WindowBackground}">

    <StackPanel Margin="20,18">

        <TextBlock Text="Indexing full-text search…" HorizontalAlignment="Left"
            FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BodyForeground}"/>

        <ProgressBar Height="15" Margin="0,12,0,4" IsIndeterminate="True"/>

        <TextBlock Text="One-time setup after this update - only takes a few seconds." Margin="0,4,0,0" TextWrapping="Wrap"
            FontSize="11.5" Opacity="0.8" Foreground="{DynamicResource BodyForeground}"/>

    </StackPanel>

</Window>
