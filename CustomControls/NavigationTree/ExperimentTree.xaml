<UserControl x:Class="ExperimentTree"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:data="clr-namespace:ElnCoreModel;assembly=ElnCoreModel"
             xmlns:local="clr-namespace:CustomControls"
             xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=data:tblUsers}"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        
        <local:ProjectsCollectionViewConverter x:Key="projectsCollectionViewConv"/>
        <local:ProjectFoldersCollectionViewConverter x:Key="projectFoldersCollectionViewConv"/>
        <local:ExperimentsCollectionViewConverter x:Key="expCollectionViewConv"/>
        <local:BindingTypeConverter x:Key="bindingTypeConv"/>
        <local:IntegerToBooleanConverter x:Key="intToBooleanConv"/>
        <local:NavTreeDropHandler x:Key="navTreeDropHandler"/>

    </UserControl.Resources>

    <Border CornerRadius="6" BorderThickness="1" Padding="4"
        Background="{DynamicResource InnerPanelBackground}" BorderBrush="{DynamicResource TreePanelBorder}">

        <!--Virtualized: selecting/scrolling to an experiment node currently scrolled out of view still works,
            since ExperimentTree's container-lookup helpers walk the known Project -> ProjFolder -> Experiment
            path, realizing each ancestor container in turn via VirtualizingPanel.BringIndexIntoViewPublic
            instead of requiring the whole tree pre-realized.-->
        <TreeView x:Name="navTree" Background="Transparent"
            ItemsSource="{Binding tblProjects, Converter={StaticResource projectsCollectionViewConv}}"
            TreeViewItem.Selected="TreeViewItem_Selected" TreeViewItem.Unselected="TreeViewItem_Unselected" Padding="2,2,2,8" BorderThickness="0"
            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
            dd:DragDrop.IsDragSource="True"
            dd:DragDrop.IsDropTarget="True"
            dd:DragDrop.UseDefaultDragAdorner="false"
            dd:DragDrop.DropTargetAdornerBrush="#FF6868FF"
            dd:DragDrop.EffectMoveAdornerTemplate="{x:Null}"
            dd:DragDrop.DropHandler="{StaticResource navTreeDropHandler}">

            <TreeView.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </TreeView.ItemsPanel>

            <TreeView.Resources>

                <!--Project nodes-->
                <HierarchicalDataTemplate DataType="{x:Type data:tblProjects}" 
                  ItemsSource="{Binding tblProjFolders,Converter={StaticResource projectFoldersCollectionViewConv}}">
                    <local:ProjectTreeHeader RequestDeleteProject="projectHeader_RequestDeleteProject" RequestAddFolder="projectHeader_RequestAddFolder" Margin="0,0,0,1"/>
                </HierarchicalDataTemplate>

                <!--Project Folder nodes -->
                <HierarchicalDataTemplate DataType="{x:Type data:tblProjFolders}" ItemsSource="{Binding tblExperiments, 
                  Converter={StaticResource expCollectionViewConv}}">
                    <local:ProjFolderTreeHeader RequestAddExperiment="folderHeader_RequestAddExperiment"
                       RequestDeleteFolder="folderHeader_RequestDeleteFolder" RequestArchiveFolder="folderHeader_RequestArchiveFolder" Margin="0,0,0,1"/>
                </HierarchicalDataTemplate>

                <!--Experiment nodes-->
                <DataTemplate DataType="{x:Type data:tblExperiments}">
                    <local:ExpTreeHeader Margin="-16,0,0,0"/>
                </DataTemplate>

            </TreeView.Resources>

            <TreeView.ItemContainerStyle>

                <Style TargetType="{x:Type TreeViewItem}">
                    <!--Specifies the selection/deselection background behavior of the expItem-->
                    <Setter Property="Template" Value="{StaticResource ExperimentTreeViewItem}"/>
                    <Setter Property="IsExpanded" Value="{Binding IsNodeExpanded,Converter={StaticResource intToBooleanConv},
                        Mode=TwoWay}"/>
                    <!--Every level (Project's Folders, Folder's Experiments) needs the same virtualizing panel as
                        the root TreeView, so ExperimentTree's container-lookup helpers can realize an off-screen
                        item's container at any depth, not just at the top level.-->
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

            </TreeView.ItemContainerStyle>

        </TreeView>
    </Border>
</UserControl>
