<UserControl x:Class="ExperimentTree"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:data="clr-namespace:ElnCoreModel;assembly=ElnCoreModel"
             xmlns:local="clr-namespace:CustomControls"
             xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=data:tblUsers}"
             d:DesignHeight="450" d:DesignWidth="300">

    <UserControl.Resources>

        <local:ProjectsCollectionViewConverter x:Key="projectsCollectionViewConv"/>
        <local:ProjectFoldersCollectionViewConverter x:Key="projectFoldersCollectionViewConv"/>
        <local:ExperimentsCollectionViewConverter x:Key="expCollectionViewConv"/>
        <local:BindingTypeConverter x:Key="bindingTypeConv"/>
        <local:IntegerToBooleanConverter x:Key="intToBooleanConv"/>
        <local:NavTreeDropHandler x:Key="navTreeDropHandler"/>

        <!--Drag adorner previews (dd:DragDrop.DragAdornerTemplateSelector below): a lightweight header-only
            + capped child-count summary, instead of gong-wpf-dragdrop's default full screen-capture adorner,
            which renders the dragged item's complete, currently expanded subtree as-is and can get very long
            for large projects/folders. Built from simple icon+title visuals rather than the full ProjectTreeHeader/
            ProjFolderTreeHeader/ExpTreeHeader controls, since those assume a TreeViewItem ancestor and drive
            editing/context menus that don't apply to a disconnected drag ghost.-->
        
        <local:StringToVisibilityConverter x:Key="strToVisibilityConv"/>
        <local:DragPreviewFoldersConverter x:Key="dragPreviewFoldersConv"/>
        <local:DragPreviewExperimentsConverter x:Key="dragPreviewExperimentsConv"/>
        <local:RemainingItemsSummaryConverter x:Key="remainingItemsSummaryConv"/>

        <Style x:Key="dragAdornerCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InnerPanelBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TreePanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="5,4,8,4"/>
            <Setter Property="MaxWidth" Value="240"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            
            <!--Seeds Foreground inheritance for descendant TextBlocks (child-row / "+N more" text) that don't set
                their own Foreground - a Border has no Foreground of its own, so without this they default to
                TextBlock's built-in black instead of following the active skin.-->
            <Setter Property="TextElement.Foreground" Value="{DynamicResource BodyForeground}"/>
            
        </Style>

        <DataTemplate x:Key="dragAdornerProjectTemplate">
            <Border Style="{StaticResource dragAdornerCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Height="16" Margin="0,1,0,0" Content="{DynamicResource FolderClosedIcon}"/>
                        <TextBlock Text="{Binding Title}" FontWeight="demibold" FontStyle="Italic" Margin="3,0,0,0"
                            Foreground="{DynamicResource ProjectTitleForeground}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding tblProjFolders, Converter={StaticResource dragPreviewFoldersConv}}" Margin="19,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FolderName}" FontStyle="Italic" FontSize="11.5" Opacity="0.7"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="19,2,0,0" FontStyle="Italic" FontSize="11" Opacity="0.6"
                        Text="{Binding tblProjFolders, Converter={StaticResource remainingItemsSummaryConv}, ConverterParameter=3}"
                        Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource strToVisibilityConv}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="dragAdornerFolderTemplate">
            <Border Style="{StaticResource dragAdornerCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Height="16" Content="{DynamicResource GrayDotIcon}"/>
                        <TextBlock Text="{Binding FolderName}" FontWeight="demibold" FontStyle="Italic" Margin="3,0,0,0"
                            Foreground="{DynamicResource TitleForeground}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding tblExperiments, Converter={StaticResource dragPreviewExperimentsConv}}" Margin="19,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ExperimentID}" FontStyle="Italic" FontSize="11.5" Opacity="0.7"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="19,2,0,0" FontStyle="Italic" FontSize="11" Opacity="0.6"
                        Text="{Binding tblExperiments, Converter={StaticResource remainingItemsSummaryConv}, ConverterParameter=3}"
                        Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource strToVisibilityConv}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="dragAdornerExperimentTemplate">
            <Border Style="{StaticResource dragAdornerCard}">
                <TextBlock Text="{Binding ExperimentID}" FontStyle="Italic" Foreground="{DynamicResource ExperimentIdForeground}"/>
            </Border>
        </DataTemplate>

        <local:DragAdornerTemplateSelector x:Key="dragAdornerSelector"
            ProjectTemplate="{StaticResource dragAdornerProjectTemplate}"
            FolderTemplate="{StaticResource dragAdornerFolderTemplate}"
            ExperimentTemplate="{StaticResource dragAdornerExperimentTemplate}"/>

        <!-- Toolbar button chrome: plain icon buttons (no hover-text-color trigger needed) -->
        <Style x:Key="NavToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Toolbar button chrome: icon+text buttons (dark+hover reverts text to Black) -->
        <Style x:Key="NavToolbarTextButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource BodyForeground}"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(local:DarkModeHelper.IsDarkMode), RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="Black"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Toolbar icon hover-swap: base Content comes from the DarkModeHelper.BaseContent
             attached DP (set per-instance to the theme-aware DynamicResource icon). While the ancestor
             Button is hovered in dark mode, Content reverts to HoverOverrideContent (the fixed light
             icon) so it stays legible against the button's light hover highlight.
             Base value must be a Style Setter (not a local attribute) so the trigger can override it. -->
        <Style x:Key="IconHoverSwapStyle" TargetType="ContentControl">
            <Setter Property="Content" Value="{Binding Path=(local:DarkModeHelper.BaseContent), RelativeSource={RelativeSource Self}}"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Path=(local:DarkModeHelper.IsDarkMode), RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Content" Value="{Binding Path=(local:DarkModeHelper.HoverOverrideContent), RelativeSource={RelativeSource Self}}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- cboUsers sequenceNr sorting -->
        <CollectionViewSource x:Key="cvsSortedUsers" Source="{Binding Database.tblUsers}">
            <CollectionViewSource.SortDescriptions>
                <componentModel:SortDescription PropertyName="SequenceNr" Direction="Ascending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>

    </UserControl.Resources>

    <DockPanel>

        <DockPanel DockPanel.Dock="top" Margin="2,0,2,6" HorizontalAlignment="Left">

            <local:ThemedComboBox x:Name="cboUsers" x:FieldModifier="public" CornerRadius="6" BorderThickness="1" Margin="1,0,6,0" VerticalAlignment="Center"
                    MinWidth="94" FontSize="11.5" FontFamily="Verdana"
                    ItemsSource="{Binding Source={StaticResource cvsSortedUsers}}" DisplayMemberPath="UserID"
                    IsDarkMode="{Binding Path=(local:DarkModeHelper.IsDarkMode), RelativeSource={RelativeSource Self}}"
                    IconDark="{StaticResource icoUser2_Dark}"
                    IconLight="{StaticResource icoUser2}"
                    ItemMouseOverBackgroundDark="#FF1E4B6D"
                    BorderBrushDark="#FF6D6D6D"
                    BackgroundDark="#FF333333"
                    SelectionChanged="cboUsers_SelectionChanged"/>

            <Button x:Name="btnAddProject" Style="{StaticResource NavToolbarTextButtonStyle}" VerticalAlignment="Center"
                ToolTip="Add a new project" Margin="0,0,4,0" Padding="3,1,5,4" Click="btnAddProject_Click">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource IconHoverSwapStyle}" Height="16" Margin="3,1,4,0"
                        local:DarkModeHelper.BaseContent="{DynamicResource NewFolderIcon}"
                        local:DarkModeHelper.HoverOverrideContent="{StaticResource icoNewFolder}"/>
                    <TextBlock Text="Add" Margin="0,0,2,-2" VerticalAlignment="Center" FontFamily="Verdana" FontSize="11.5"/>
                </StackPanel>
            </Button>

            <Button x:Name="btnAddFolder" Style="{StaticResource NavToolbarTextButtonStyle}" VerticalAlignment="Center" Padding="3,1,3,3"
                ToolTip="Add an experiment group to the current project.&#x0a;----------------------------------------------------&#x0a;Experiment groups let you organize your project experiments into user-defined &#x0a;categories such as ‘Preliminary Experiments’, ‘Optimized Synthesis’, ‘Step 1’, etc.  &#x0a;&#x0a;Initially, all project experiments are in the default group ‘All experiments’.&#x0a;"
                Click="btnAddFolder_Click">
                <StackPanel Orientation="Horizontal">
                    <Grid>
                        <ContentControl Style="{StaticResource IconHoverSwapStyle}" Height="16" HorizontalAlignment="Left" Margin="6,2,0,0"
                            local:DarkModeHelper.BaseContent="{DynamicResource GrayDotIcon}"
                            local:DarkModeHelper.HoverOverrideContent="{StaticResource icoGrayDot}"/>
                        <ContentControl Style="{StaticResource IconHoverSwapStyle}" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                            local:DarkModeHelper.BaseContent="{DynamicResource NewIcon}"
                            local:DarkModeHelper.HoverOverrideContent="{StaticResource icoNew}"/>
                    </Grid>
                    <TextBlock Text="Add" Margin="0,0,4,0" VerticalAlignment="Center" FontFamily="Verdana" FontSize="11.5"/>
                </StackPanel>
            </Button>

            <Button x:Name="btnNavMenu" Style="{StaticResource NavToolbarTextButtonStyle}" VerticalAlignment="Center" Margin="4,0,0,0" Padding="5,1,5,3"
                ToolTip="Tree navigation" Click="btnNavMenu_Click">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource IconHoverSwapStyle}" Height="16" Width="16" Margin="0,0,4,0"
                        local:DarkModeHelper.BaseContent="{DynamicResource TreeViewOptionsIcon}"
                        local:DarkModeHelper.HoverOverrideContent="{StaticResource icoTreeViewOptions}"/>
                    <TextBlock Text="View" VerticalAlignment="Center" FontFamily="Verdana" FontSize="11.5"/>
                    <TextBlock Text="&#x25BE;" FontSize="13" Margin="2,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!--DynamicResource values inside a Popup go stale after an app skin swap (Popup content is
                logically disconnected from the resource-change invalidation walk, so it never hears about
                later ApplySkin calls - only reflects whichever skin was active when it was first realized).
                Fixed in code-behind (RefreshNavMenuSkin, called from btnNavMenu_Click) by re-applying
                SetResourceReference on every DynamicResource-bound property below right before the popup
                opens. Any new menu item must be added to that method too.-->

            <Popup x:Name="navMenuPopup" PlacementTarget="{Binding ElementName=btnNavMenu}" Placement="Bottom"
                StaysOpen="False" AllowsTransparency="True">
                
                <Border x:Name="navMenuBorder" Background="{DynamicResource InnerPanelBackground}" BorderBrush="{DynamicResource TreePanelBorder}"
                    BorderThickness="1" CornerRadius="6" Padding="3">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="3" BlurRadius="8" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>

                        <Button x:Name="btnCollapseProjects" Style="{StaticResource NavToolbarTextButtonStyle}" HorizontalContentAlignment="Left"
                            HorizontalAlignment="Stretch" Padding="5,4,12,4" Click="btnCollapseProjects_Click">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl x:Name="iconCollapseProjects" Style="{StaticResource IconHoverSwapStyle}" Height="16" Width="14" Margin="1,1,6,0"
                                    local:DarkModeHelper.BaseContent="{DynamicResource CollapseAllIcon}"
                                    local:DarkModeHelper.HoverOverrideContent="{StaticResource icoCollapseAll}"/>
                                <TextBlock Text="Collapse Projects" VerticalAlignment="Center" FontFamily="Verdana" FontSize="11.5"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnCollapseAll" Style="{StaticResource NavToolbarTextButtonStyle}" HorizontalContentAlignment="Left"
                            HorizontalAlignment="Stretch" Padding="5,4,12,4" Click="btnCollapseAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl x:Name="iconCollapseAll" Style="{StaticResource IconHoverSwapStyle}" Height="16" Width="14" Margin="1,1,6,0"
                                    local:DarkModeHelper.BaseContent="{DynamicResource CollapseAllIcon}"
                                    local:DarkModeHelper.HoverOverrideContent="{StaticResource icoCollapseAll}"/>
                                <TextBlock Text="Collapse SubProjects" VerticalAlignment="Center" FontFamily="Verdana" FontSize="11.5"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnExpandAll" Style="{StaticResource NavToolbarTextButtonStyle}" HorizontalContentAlignment="Left"
                            HorizontalAlignment="Stretch" Padding="5,4,12,4" Click="btnExpandAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl x:Name="iconExpandAll" Style="{StaticResource IconHoverSwapStyle}" Height="16" Width="14" Margin="1,1,6,0"
                                    local:DarkModeHelper.BaseContent="{DynamicResource ExpandAllIcon}"
                                    local:DarkModeHelper.HoverOverrideContent="{StaticResource icoExpandAll}"/>
                                <TextBlock Text="Expand All" VerticalAlignment="Center" FontFamily="Verdana" FontSize="11.5"/>
                            </StackPanel>
                        </Button>

                        <Separator/>

                        <Button x:Name="btnLocateExperiment" Style="{StaticResource NavToolbarTextButtonStyle}" HorizontalContentAlignment="Left"
                            HorizontalAlignment="Stretch" Padding="5,4,12,4" Click="btnLocateExperiment_Click">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl x:Name="iconLocateExperiment" Style="{StaticResource IconHoverSwapStyle}" Height="16" Width="16" Margin="1,1,6,0"
                                    local:DarkModeHelper.BaseContent="{DynamicResource LocateExperimentIcon}"
                                    local:DarkModeHelper.HoverOverrideContent="{StaticResource icoLocateExperiment}"/>
                                <TextBlock Text="Current Experiment" VerticalAlignment="Center" FontFamily="Verdana" FontSize="11.5"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Border>
            </Popup>

        </DockPanel>

    <Border CornerRadius="6" BorderThickness="1" Padding="4"
        Background="{DynamicResource InnerPanelBackground}" BorderBrush="{DynamicResource TreePanelBorder}">

        <!--Virtualized: selecting/scrolling to an experiment node currently scrolled out of view still works,
            since ExperimentTree's container-lookup helpers walk the known Project -> ProjFolder -> Experiment
            path, realizing each ancestor container in turn via VirtualizingPanel.BringIndexIntoViewPublic
            instead of requiring the whole tree pre-realized.-->
        
        <TreeView x:Name="navTree" Background="Transparent"
            ItemsSource="{Binding tblProjects, Converter={StaticResource projectsCollectionViewConv}}"
            TreeViewItem.Selected="TreeViewItem_Selected" TreeViewItem.Unselected="TreeViewItem_Unselected" Padding="2,2,2,8" BorderThickness="0"
            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
            dd:DragDrop.IsDragSource="True"
            dd:DragDrop.IsDropTarget="True"
            dd:DragDrop.UseDefaultDragAdorner="false"
            dd:DragDrop.DragAdornerTemplateSelector="{StaticResource dragAdornerSelector}"
            dd:DragDrop.DropTargetAdornerBrush="#FF6868FF"
            dd:DragDrop.EffectMoveAdornerTemplate="{x:Null}"
            dd:DragDrop.DropHandler="{StaticResource navTreeDropHandler}">

            <TreeView.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </TreeView.ItemsPanel>

            <TreeView.Resources>

                <!--Project nodes-->
                <HierarchicalDataTemplate DataType="{x:Type data:tblProjects}" 
                  ItemsSource="{Binding tblProjFolders,Converter={StaticResource projectFoldersCollectionViewConv}}">
                    <local:ProjectTreeHeader RequestDeleteProject="projectHeader_RequestDeleteProject" RequestAddFolder="projectHeader_RequestAddFolder" Margin="0,0,0,1"/>
                </HierarchicalDataTemplate>

                <!--Project Folder nodes -->
                <HierarchicalDataTemplate DataType="{x:Type data:tblProjFolders}" ItemsSource="{Binding tblExperiments, 
                  Converter={StaticResource expCollectionViewConv}}">
                    <local:ProjFolderTreeHeader RequestAddExperiment="folderHeader_RequestAddExperiment"
                       RequestDeleteFolder="folderHeader_RequestDeleteFolder" RequestArchiveFolder="folderHeader_RequestArchiveFolder" Margin="0,0,0,1"/>
                </HierarchicalDataTemplate>

                <!--Experiment nodes-->
                <DataTemplate DataType="{x:Type data:tblExperiments}">
                    <local:ExpTreeHeader Margin="-16,0,0,0"/>
                </DataTemplate>

            </TreeView.Resources>

            <TreeView.ItemContainerStyle>

                <Style TargetType="{x:Type TreeViewItem}">
                    
                    <!--Specifies the selection/deselection background behavior of the expItem-->
                    <Setter Property="Template" Value="{StaticResource ExperimentTreeViewItem}"/>
                    <Setter Property="IsExpanded" Value="{Binding IsNodeExpanded,Converter={StaticResource intToBooleanConv},
                        Mode=TwoWay}"/>
                    
                    <!--Every level (Project's Folders, Folder's Experiments) needs the same virtualizing panel as
                        the root TreeView, so ExperimentTree's container-lookup helpers can realize an off-screen
                        item's container at any depth, not just at the top level.-->
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                    
                </Style>

            </TreeView.ItemContainerStyle>

        </TreeView>
    </Border>

    </DockPanel>
</UserControl>
