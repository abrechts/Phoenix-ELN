<Window x:Class="dlgEquivalentsFilter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomControls"
        mc:Ignorable="d"
        Title="Equivalents" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        SizeToContent="Height" Width="330" ResizeMode="NoResize" Background="{StaticResource DarkPanelBackground2}">

    <Window.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CustomControls;component/Resources/SkinDark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ModePillStyle" TargetType="ToggleButton">
                <Setter Property="Margin" Value="0,0,5,5"/>
                <Setter Property="Padding" Value="9,3,9,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="border" Background="#334D84D7" BorderBrush="#FF4D84D7" BorderThickness="1" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#4D5FA0D7"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF4D84D7"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF9BCBFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="18,14,18,12">

        <TextBlock Text="Equivalents Range" FontWeight="Bold" FontSize="14" Foreground="LightBlue" HorizontalAlignment="Center"/>

        <Separator Margin="0,8,0,12" Height="0.9"/>

        <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,4">
            <RadioButton x:Name="rbAny" GroupName="EquivMode" IsChecked="True" Style="{StaticResource ModePillStyle}">
                <TextBlock Text="any" Foreground="White"/>
            </RadioButton>
            <RadioButton x:Name="rbAtLeast" GroupName="EquivMode" Style="{StaticResource ModePillStyle}">
                <TextBlock Text="&#8805;" Foreground="White"/>
            </RadioButton>
            <RadioButton x:Name="rbAtMost" GroupName="EquivMode" Style="{StaticResource ModePillStyle}">
                <TextBlock Text="&#8804;" Foreground="White"/>
            </RadioButton>
            <RadioButton x:Name="rbEqualTo" GroupName="EquivMode" Style="{StaticResource ModePillStyle}">
                <TextBlock Text="=" Foreground="White"/>
            </RadioButton>
            <RadioButton x:Name="rbBetween" GroupName="EquivMode" Style="{StaticResource ModePillStyle}">
                <TextBlock Text="between" Foreground="White"/>
            </RadioButton>
        </WrapPanel>

        <Grid x:Name="pnlSingleValue" HorizontalAlignment="Center" Margin="0,6,0,12">
            <StackPanel Orientation="Horizontal">
                <local:NumericTextBox x:Name="txtValue" SignificantDigits="3" PositiveNumbersOnly="True" MinWidth="60"
                    CaretBrush="White" Foreground="White" Background="Transparent" BorderThickness="1" BorderBrush="LightGray"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="4,3"/>
                <TextBlock x:Name="blkUnit" Foreground="LightGray" VerticalAlignment="Center" Margin="6,0,0,0"
                    ToolTipService.InitialShowDelay="250"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="pnlRangeValue" HorizontalAlignment="Center" Margin="0,6,0,12" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <local:NumericTextBox x:Name="txtValueFrom" SignificantDigits="3" PositiveNumbersOnly="True" MinWidth="52"
                    CaretBrush="White" Foreground="White" Background="Transparent" BorderThickness="1" BorderBrush="LightGray"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="4,3"/>
                <TextBlock Text="and" Foreground="LightGray" VerticalAlignment="Center" Margin="6,0,6,0"/>
                <local:NumericTextBox x:Name="txtValueTo" SignificantDigits="3" PositiveNumbersOnly="True" MinWidth="52"
                    CaretBrush="White" Foreground="White" Background="Transparent" BorderThickness="1" BorderBrush="LightGray"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="4,3"/>
                <TextBlock x:Name="blkRangeUnit" Foreground="LightGray" VerticalAlignment="Center" Margin="6,0,0,0"
                    ToolTipService.InitialShowDelay="250"/>
            </StackPanel>
        </Grid>

        <Separator Margin="0,0,0,10" Height="0.9"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="btnOK" Content="OK" IsDefault="True" Padding="18,3" Margin="0,0,8,0"/>
            <Button x:Name="btnCancel" Content="Cancel" IsCancel="True" Padding="10,3"/>
        </StackPanel>

    </StackPanel>

</Window>
