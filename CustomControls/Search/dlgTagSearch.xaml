<Window x:Class="dlgTagSearch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomControls"
        mc:Ignorable="d"
        Title="Experiment Tags" TextOptions.TextFormattingMode="Display" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True"
        Height="580" MinHeight="420" Width="520" MinWidth="460" Background="{StaticResource DarkPanelBackground2}">

    <Window.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <!--This window is always dark regardless of the active app skin (same convention as
                    dlgSearch/dlgFullTextSearch/dlgTags).-->
                <ResourceDictionary Source="/CustomControls;component/Resources/SkinDark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:IntegerToVisibilityConverter x:Key="intToVisibilityConv"/>

            <!--ExpTreeHeader (shared with the NavTree elsewhere) carries its own inherent line-height/icon
                whitespace that isn't reachable via the ListBoxItem's own Padding/Margin - a small negative
                margin here compresses that, scoped to just this result list's own template (same as
                dlgMaterialSearch's expResultItem).-->
            <DataTemplate x:Key="expResultItem">
                <StackPanel HorizontalAlignment="Stretch" Margin="0,-1,10,-1">
                    <local:ExpTreeHeader DataContext="{Binding}"/>
                </StackPanel>
            </DataTemplate>

            <!--Default ListBoxItem chrome adds its own padding on top of the DataTemplate - tightened here
                since expResultItem's content (a single ExpTreeHeader row) is short enough that the default
                padding read as excessive vertical spacing between results.-->
            <Style x:Key="CompactResultItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="2,0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
            </Style>

            <!--Same pill styling as the tag chips in StepSummary's Exp. Info panel / dlgTags, made toggleable:
                unchecked is the translucent "unselected" pill, checked brightens to a solid, lighter-bordered pill
                so the currently active filter tags are obvious at a glance.-->
            <Style x:Key="TagFilterPillStyle" TargetType="ToggleButton">
                <Setter Property="Margin" Value="0,3,6,3"/>
                <Setter Property="Padding" Value="9,3,9,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="border" Background="#334D84D7" BorderBrush="#FF4D84D7" BorderThickness="1" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#4D5FA0D7"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF4D84D7"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF9BCBFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20,14,20,8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock Text="Search by Tags" FontWeight="Bold" HorizontalAlignment="Center" FontSize="14" Foreground="LightBlue"/>

            <Separator Margin="0,8,0,8" Height="0.9"/>

            <TextBlock TextWrapping="Wrap" Margin="0,2,0,8" Foreground="lightgray" FontStyle="Italic" HorizontalAlignment="Center">
                <Run Text="Select one or more tags to find experiments having"/>
                <Run FontWeight="Bold" Text="all"/>
                <Run Text="of the selected tags:"/>
            </TextBlock>

            <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Style="{StaticResource SkinScrollViewerStyle}">

                <Grid>

                    <ItemsControl x:Name="icTags" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="tagToggle_Click" Style="{StaticResource TagFilterPillStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Tag.TagName}" Foreground="{DynamicResource BodyForeground}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Tag.tblExperimentTags.Count, StringFormat=' ({0})'}"
                                            Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="- no tags in use yet - assign one to an experiment first -" HorizontalAlignment="Center"
                        FontStyle="Italic" FontSize="11.5" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" Margin="0,6,0,0"
                        Visibility="{Binding ElementName=icTags, Path=Items.Count, Converter={StaticResource intToVisibilityConv}, ConverterParameter=invert}"/>

                </Grid>

            </ScrollViewer>

            <Separator Margin="0,10,0,6" Height="0.9"/>

        </StackPanel>

        <Grid Grid.Row="1">

            <ListBox x:Name="lstResults" Background="Transparent" BorderThickness="0" local:DarkModeHelper.IsDarkMode="True"
                HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource CompactResultItemStyle}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="False"
                ItemTemplate="{StaticResource expResultItem}" Padding="0,0,0,4"/>

            <TextBlock x:Name="blkPlaceholder" Text="---  select tags to search  ---" Foreground="#FFFDCE79" HorizontalAlignment="Center"
                VerticalAlignment="Top" Margin="0,20,0,0" FontStyle="Italic" FontSize="11.5" Opacity="0.95"
                Visibility="{Binding ElementName=lstResults, Path=Items.Count, Converter={StaticResource intToVisibilityConv}, ConverterParameter=invert}"/>

        </Grid>

        <StackPanel Grid.Row="2">
            <Separator Margin="0,4,0,4" Height="0.9"/>
            <TextBlock x:Name="blkHitInfo" HorizontalAlignment="Center" Foreground="lightblue"/>
        </StackPanel>

    </Grid>

</Window>
