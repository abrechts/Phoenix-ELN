<UserControl x:Class="StepSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CustomControls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:base="clr-namespace:ElnCoreModel;assembly=ElnCoreModel"      
             d:DataContext="{d:DesignInstance Type=base:tblUsers}"
             mc:Ignorable="d" 
            d:DesignWidth="250" d:FontSize="12">

    <UserControl.Resources>

        <local:IntegerToVisibilityConverter x:Key="intToVisConv"/>

        <CollectionViewSource x:Key="cvsStepExperiments" IsLiveSortingRequested="True">
            <CollectionViewSource.SortDescriptions>
                <componentModel:SortDescription PropertyName="Scale" Direction="Descending"/>
            </CollectionViewSource.SortDescriptions>
            <CollectionViewSource.LiveSortingProperties>
                <system:String>Yield</system:String>
            </CollectionViewSource.LiveSortingProperties>
        </CollectionViewSource>

        <DataTemplate x:Key="expTreeItem">
            <local:ExpTreeHeader SuppressContextMenu="true" Margin="0,-1" FontSize="11.5"/>
        </DataTemplate>

    </UserControl.Resources>

    <Border BorderThickness="1" CornerRadius="6" Padding="4,2,4,4"
        Background="{DynamicResource InnerPanelBackground}" BorderBrush="{DynamicResource PanelBorder}"
        TextBlock.Foreground="{DynamicResource BodyForeground}">

        <DockPanel Margin="0,4,0,4" >

            <!--Ref.Reactant-->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">

                <TextBlock Text="Ref. Reactant" DockPanel.Dock="top" VerticalAlignment="Center"
                  Foreground="{DynamicResource TitleForeground}"
                  Background="transparent" FontStyle="Italic" Padding="1,0" Margin="76,0,0,2"
                  HorizontalAlignment="left" Opacity="0.9" FontWeight="Bold" FontSize="12.5"/>

                <Separator Margin="0,0,0,0" Background="#FF4D84D7"/>

                <StackPanel Margin="0,0,0,0" Background="Transparent">

                    <StackPanel Orientation="Horizontal" Margin="6,3,0,0" >
                        <TextBlock Text="Elemental:" Width="70" FontWeight="DemiBold"/>
                        <TextBlock x:Name="blkReactEf" d:Text="C₁₇H₂₃NO"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0" >
                        <TextBlock Text="MW:" Width="70" FontWeight="DemiBold"/>
                        <TextBlock x:Name="blkReactMw" d:Text="234.75"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0" >
                        <TextBlock Text="Exact Mass:" Width="70" FontWeight="DemiBold"/>
                        <TextBlock x:Name="blkReactEM" d:Text="233.35"/>
                    </StackPanel>

                    <StackPanel x:Name="pnlReactLinks" Orientation="Horizontal" Margin="6,0,0,0" >
                        <TextBlock Text="Web Info:" Width="70" FontWeight="DemiBold"/>
                        <TextBlock x:Name="lnkPubChemReact" Text="PubChem" TextDecorations="Underline" Cursor="Hand" Margin="0,0,4,0"
                            Foreground="{DynamicResource LinkForeground}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="6,0,0,5" >
                        <TextBlock HorizontalAlignment="Left" Text="InChIKey:" FontWeight="Demibold" VerticalAlignment="Center" Width="70"/>
                        <TextBox x:Name="blkInChIKeyReact" d:Text="CATMAVIUJSKTCV-UHFFFAOYSA-N" IsReadOnly="true" BorderThickness="0"
                            Margin="-2,4,0,0" FontSize="11.5" VerticalAlignment="Center" FontFamily="Calibri" Background="transparent">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Foreground" Value="{DynamicResource BodyForeground}"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>

                </StackPanel>

                <Separator Margin="0,0,0,2" DockPanel.Dock="top" Background="#FF4D84D7"/>

            </StackPanel>

            <!--Ref.Product-->
            <StackPanel DockPanel.Dock="Top" >

                <TextBlock Text="Ref. Product" DockPanel.Dock="top" VerticalAlignment="Center"
                   Foreground="{DynamicResource TitleForeground}"
                   Background="transparent" FontStyle="Italic" FontWeight="Bold" Padding="1,0" Margin="76,0,0,2"
                   FontSize="12.5" HorizontalAlignment="left" Opacity="0.9"/>

                <Separator Margin="0,0,0,2" Background="#FF4D84D7"/>

                <StackPanel Margin="0,0,0,0" Background="Transparent">

                    <StackPanel Orientation="Horizontal" Margin="6,3,0,0" >
                        <TextBlock Text="Elemental:" Width="70" FontWeight="DemiBold"/>
                        <TextBlock x:Name="blkProdEf" d:Text="C₁₇H₂₃NO"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0" >
                        <TextBlock Text="MW:" Width="70" FontWeight="DemiBold"/>
                        <TextBlock x:Name="blkProdMw" d:Text="234.75"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0"  >
                        <TextBlock Text="Exact Mass:" Width="70" FontWeight="DemiBold"/>
                        <TextBlock x:Name="blkProdEM" d:Text="233.35"/>
                    </StackPanel>

                    <StackPanel x:Name="pnlProdLinks" Orientation="Horizontal" Margin="6,0,0,0"  >
                        <TextBlock Text="Web Info:" Width="70" FontWeight="DemiBold"/>
                        <TextBlock x:Name="lnkPubChemProd" Text="PubChem" TextDecorations="Underline" Cursor="Hand" Margin="0,0,4,0"
                            Foreground="{DynamicResource LinkForeground}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="6,0,0,4">
                        <TextBlock HorizontalAlignment="Left" Text="InChIKey:" FontWeight="Demibold" VerticalAlignment="Center" Width="70"/>
                        <TextBox x:Name="blkInChIKeyProd" d:Text="CATMAVIUJSKTCV-UHFFFAOYSA-N" IsReadOnly="true" BorderThickness="0"
                            Margin="-2,3,0,0" FontSize="11.5" VerticalAlignment="Center" FontFamily="Calibri" Background="transparent">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Foreground" Value="{DynamicResource BodyForeground}"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>

                </StackPanel>

                <Separator Margin="0,0,0,0" DockPanel.Dock="top" Background="#FF4D84D7"/>

            </StackPanel>

            <StackPanel DockPanel.Dock="Top">

                <TextBlock Text="Exp. Info" DockPanel.Dock="top" VerticalAlignment="Center"
                Foreground="{DynamicResource TitleForeground}"
                Background="transparent" FontStyle="Italic" FontWeight="Bold" Padding="1,0" Margin="76,6,0,2"
                FontSize="12.5" HorizontalAlignment="left" Opacity="0.9"/>

                <Separator Margin="0,0,0,2" Background="#FF4D84D7"/>

                <StackPanel Margin="0,0,0,0" Background="Transparent">

                    <StackPanel Orientation="Horizontal" Margin="6,5,0,6" >
                        <TextBlock Text="Materials:" Width="70" FontWeight="DemiBold" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        <Button x:Name="btnMatTotals" Content="Required Materials" Padding="8,0,8,1" Margin="0,4"/>
                    </StackPanel>

                    <Separator Margin="0,0,0,0" DockPanel.Dock="top" Background="#FF4D84D7"/>

                </StackPanel>

            </StackPanel>

            <DockPanel Background="Transparent" DockPanel.Dock="top" Margin="0,10,0,0">

                <Grid DockPanel.Dock="top" >

                    <Grid ToolTip="Include experiments of other users &#x0a;(server connection required)" Margin="8,2,0,0">
                        <CheckBox x:Name="chkIncludeServer" FontSize="11.5" BorderBrush="#45A1FD" BorderThickness="1" HorizontalAlignment="Left" 
                          IsEnabled="false" d:IsEnabled="true" Foreground="green" Style="{StaticResource ColorCheckmarkCheckboxStyle}" >
                            <ContentControl Height="16" Margin="-0,0,4,0" VerticalAlignment="Center"
                                Content="{DynamicResource ServerUserIcon}"/>
                        </CheckBox>
                    </Grid>
                    
                    <TextBlock Text="Same Step" DockPanel.Dock="top" VerticalAlignment="Center"
                        Foreground="{DynamicResource TitleForeground}"
                        Background="transparent" FontStyle="Italic" FontWeight="Bold" Padding="1,0" Margin="76,0,0,1"
                        FontSize="12.5" HorizontalAlignment="left"/>

                    <local:ThemedComboBox x:Name="cboSortType" CornerRadius="6" BorderThickness="1" Margin="1,0,4,0" VerticalAlignment="Center" FontSize="11.5" 
                        FontFamily="Verdana" HorizontalAlignment="Right" SelectedIndex="0" Padding="0,1,0,1"
                        IsDarkMode="{Binding Path=(local:DarkModeHelper.IsDarkMode), RelativeSource={RelativeSource Self}}"
                        ItemMouseOverBackgroundDark="#FF1E4B6D" 
                        BorderBrushDark="#FF6D6D6D" 
                        BackgroundDark="#FF333333" >
                            <ComboBoxItem Content="by yield"/>
                            <ComboBoxItem Content="by scale"/>
                    </local:ThemedComboBox>

                </Grid>

                <Grid Margin="0,2,0,0">

                    <ListBox x:Name="lstStepExperiments" SelectionMode="Single" BorderThickness="0,1" BorderBrush="#FF45A1FD"
                        FocusVisualStyle="{x:Null}"
                        Grid.IsSharedSizeScope="true" AllowDrop="false" Margin="4,2,4,0" Padding="0,4,0,0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        VirtualizingStackPanel.IsVirtualizing="False" MinHeight="22"
                        IsSynchronizedWithCurrentItem="False"
                        ItemsSource="{Binding Source={StaticResource cvsStepExperiments}}"
                        ItemTemplate="{StaticResource expTreeItem}" VerticalAlignment="Top">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Background" Value="{DynamicResource ListBackground}"/>
                            </Style>
                        </ListBox.Style>
                    </ListBox>

                    <TextBlock Text="---" Margin="0,5,20,0" VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource MutedForeground}"
                        Visibility="{Binding ElementName=lstStepExperiments, Path=Items.Count, Converter={StaticResource intToVisConv}, ConverterParameter=invert}"/>

                </Grid>

            </DockPanel>

        </DockPanel>

    </Border>

</UserControl>
