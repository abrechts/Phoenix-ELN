<UserControl x:Class="RssItemGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CustomControls"
             d:DataContext="{d:DesignInstance Type=local:RssRxnGroup}"
             mc:Ignorable="d" 
             d:Height="150" d:Width="500">

    <UserControl.Resources>
        <ResourceDictionary>

            <!--This panel is always rendered light regardless of the app-wide theme toggle -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CustomControls;component/Resources/SkinLight.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="hitGroupItem">
                <local:ExpTreeHeader SuppressContextMenu="true" Margin="0,-1" FontSize="11"/>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderThickness="1" BorderBrush="#FFADADAD" CornerRadius="6" Margin="0,0,0,4" Background="white">

        <StackPanel Margin="2" >

            <StackPanel Orientation="Horizontal">
                       
                <StackPanel Margin="0,0,0,0" VerticalAlignment="Top">

                    <Label d:Content="Results 1" Content="{Binding GroupTitle}" FontWeight="demibold" FontStyle="Italic" Margin="20,0,20,2"
                        HorizontalAlignment="Center" BorderThickness="0,0,0,1" Padding="2,0,2,1" Background="white" Foreground="black"
                        BorderBrush="gray" FontSize="11.5"/>

                    <ScrollViewer MinHeight="70" MaxHeight="160" Padding="4" Margin="0,0,0,2" PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel"
                        HorizontalScrollBarVisibility="disabled" VerticalScrollBarVisibility="auto">

                        <ListBox x:Name="lstRssHits" ItemTemplate="{StaticResource hitGroupItem}" MinWidth="200" FontSize="11.5"
                            ItemsSource="{Binding ExpItems}" BorderThickness="0" HorizontalAlignment="Stretch" >
                        </ListBox>

                    </ScrollViewer>

                </StackPanel>

                <Border Background="whitesmoke" VerticalAlignment="Center" BorderThickness="1" BorderBrush="lightgray" CornerRadius="6" 
                        Margin="6">

                    <Grid>

                        <Viewbox MaxWidth="400" MaxHeight="180" MinHeight="60" StretchDirection="DownOnly">

                            <StackPanel Orientation="Horizontal" >

                                <Viewbox MinWidth="60" Margin="8,2,8,2">
                                    <ContentPresenter Content="{Binding ReactCanvas}" DataContextChanged="Canvas_DataContextChanged"/>
                                </Viewbox>

                                <StackPanel VerticalAlignment="center" Margin="0,-12,0,0">

                                    <!--Icon link to connections dialog-->
                                    <Border x:Name="lnkConnections" HorizontalAlignment="Center" Margin="-2,0,0,0" CornerRadius="6" Padding="1" 
                                       Cursor="Hand" ToolTip="Get all steps leading to this &#x0a;step and away from it." ToolTipService.InitialShowDelay="500">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FFBDBDBD"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ContentControl Content="{StaticResource icoInfo}" Height="12" Opacity="0.75"/>
                                    </Border>

                                    <Grid  Width="50">
                                        <Border Margin="6,2,8,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="0.9" BorderBrush="black" 
                                           BorderThickness="0,1,0,0"/>
                                        <Viewbox Margin="0,0,6,0" HorizontalAlignment="Right" VerticalAlignment="center" Width="8" Height="5" 
                                          Stretch="Fill" UseLayoutRounding="False">
                                            <Polygon  Points="0,0 8,3 0,6 0,3" Fill="#FF000000" Stroke="#FF000000" StrokeThickness="1" 
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Height="7" Width="10" />
                                        </Viewbox>
                                    </Grid>

                                </StackPanel>

                                <Viewbox MinWidth="60" Margin="8,2,22,2" >
                                    <ContentPresenter Content="{Binding ProdCanvas}" DataContextChanged="Canvas_DataContextChanged"/>
                                </Viewbox>

                            </StackPanel>

                        </Viewbox>
  
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
    
</UserControl>
