<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Dark skin: role-named brushes consumed via DynamicResource throughout the application.
        SkinLight.xaml must define the identical set of keys. The active skin is swapped at
        runtime by DarkModeHelper.ApplySkin.-->

    <!--Main window chrome-->
    <SolidColorBrush x:Key="WindowBackground" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="MainMenuBackground" Color="#FF3D3D3D"/>
    <SolidColorBrush x:Key="MainMenuBorder" Color="#FF7F7F7F"/>

    <!--Panels-->
    <SolidColorBrush x:Key="NavPanelBackground" Color="#FF474747"/>
    <SolidColorBrush x:Key="InfoPanelBackground" Color="#FF474747"/>
    <SolidColorBrush x:Key="InnerPanelBackground" Color="#FF343434"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#FF7F7F7F"/>
    <SolidColorBrush x:Key="TreePanelBorder" Color="#FF7F7F7F"/>

    <!--Inputs and text-->
    <SolidColorBrush x:Key="InputBackground" Color="#FF333333"/>
    <SolidColorBrush x:Key="BodyForeground" Color="WhiteSmoke"/>
    <SolidColorBrush x:Key="TitleForeground" Color="#FFD4E5FD"/>
    <SolidColorBrush x:Key="MutedForeground" Color="WhiteSmoke"/>
    <SolidColorBrush x:Key="ListBackground" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="LinkForeground" Color="#FFABCEFF"/>
    <SolidColorBrush x:Key="FolderArrowHighlight" Color="Yellow"/>
    <SolidColorBrush x:Key="ProjectTitleForeground" Color="WhiteSmoke"/>
    <SolidColorBrush x:Key="ExperimentIdForeground" Color="WhiteSmoke"/>
    <SolidColorBrush x:Key="AddExperimentLinkBackground" Color="Transparent"/>

    <!--Navigation tree-->
    <SolidColorBrush x:Key="TreeItemBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="TreeExpanderGlyph" Color="#FFAAAAAA"/>
    <SolidColorBrush x:Key="PinGlyphForeground" Color="LightBlue"/>
    <SolidColorBrush x:Key="CurrentExperimentHighlight" Color="#FF2272BC"/>
    <SolidColorBrush x:Key="WorkflowInProgressFill" Color="#FFEE6E6E"/>
    <SolidColorBrush x:Key="WorkflowFinalizedFill" Color="#FF66A0DB"/>

    <!--Scrollbar (unified flat scrollbar used app-wide via SkinScrollViewerTemplate)-->
    <SolidColorBrush x:Key="ScrollThumbBackground" Color="#FF686868"/>
    <SolidColorBrush x:Key="ScrollThumbBackgroundHover" Color="#FF909090"/>
    <SolidColorBrush x:Key="ScrollThumbBackgroundDragging" Color="#FFB0B0B0"/>

    <!--Icons: role-named forwarders to the light/dark Viewbox resources in SpecialIcons.xaml.
        x:Shared="false" must be kept, since a Viewbox instance can only appear once in the visual tree.-->
    <ContentControl x:Key="ServerUserIcon" x:Shared="false" Content="{StaticResource icoServerUser_Dark}"/>
    <ContentControl x:Key="GrayDotIcon" x:Shared="false" Content="{StaticResource icoGrayDot_Dark}"/>
    <ContentControl x:Key="OpenFolderIcon" x:Shared="false" Content="{StaticResource icoOpenFolder_Dark}"/>
    <ContentControl x:Key="FromServerIcon" x:Shared="false" Content="{StaticResource icoFromServer_Dark}"/>
    <ContentControl x:Key="NewFolderIcon" x:Shared="false" Content="{StaticResource icoNewFolder_Dark}"/>
    <ContentControl x:Key="NewIcon" x:Shared="false" Content="{StaticResource icoNew_Dark}"/>
    <ContentControl x:Key="FolderClosedIcon" x:Shared="false" Content="{StaticResource icoFolderNoFill_Dark}"/>
    <ContentControl x:Key="WarningCircleIcon" x:Shared="false" Content="{StaticResource icoWarningCircleRed_Dark}"/>
    <ContentControl x:Key="CollapseAllIcon" x:Shared="false" Content="{StaticResource icoCollapseAll_Dark}"/>
    <ContentControl x:Key="ExpandAllIcon" x:Shared="false" Content="{StaticResource icoExpandAll_Dark}"/>
    <ContentControl x:Key="LocateExperimentIcon" x:Shared="false" Content="{StaticResource icoLocateExperiment_Dark}"/>
    <ContentControl x:Key="FocusExperimentIcon" x:Shared="false" Content="{StaticResource icoFocusExperiment_Dark}"/>
    <ContentControl x:Key="TreeViewOptionsIcon" x:Shared="false" Content="{StaticResource icoTreeViewOptions_Dark}"/>
    <ContentControl x:Key="SortAscendingIcon" x:Shared="false" Content="{StaticResource icoSortAscending_Dark}"/>

</ResourceDictionary>
