<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    
    <!--Dark mode Menu and MenuItem Styles-->
    <!--==================================-->


    <!--common dark mode background-->
    <SolidColorBrush x:Key="mnuDarkBackground" Color="#FF4F4F4F"/>

    <!--Dark mode panel colors (edit these to retheme all dark mode panels at once)-->
    <SolidColorBrush x:Key="DarkPanelBackground" Color="#FF474747"/>
    <SolidColorBrush x:Key="DarkPanelBackground2" Color="#FF343434"/>
    <SolidColorBrush x:Key="DarkPanelBorder"     Color="#FF7F7F7F"/>
    <SolidColorBrush x:Key="DarkTitleForeground" Color="#FFABCEFF"/>
    <SolidColorBrush x:Key="MainMenuBgDark" Color="#FF3D3D3D"/>


    <Style x:Key="DarkModeMenuStyle" TargetType="{x:Type MenuItem}">
        
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">

                    <Border x:Name="templateRoot"        
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3"
                        SnapsToDevicePixels="True">

                        <Grid>

                            <Grid x:Name="SubmenuPresenter">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="IconColumn" Width="Auto" SharedSizeGroup="MenuIcon"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="Icon"
                                    ContentSource="Icon"
                                    MaxWidth="16" Height="16"
                                    Margin="4,2,2,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                                <ContentPresenter x:Name="menuHeaderContainer"
                                    Grid.Column="2"
                                    ContentSource="Header"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                    Margin="6,3,6,3"
                                    RecognizesAccessKey="True"
                                    VerticalAlignment="Center"/>

                                <Path x:Name="rightArrow"
                                    Grid.Column="3"
                                    Data="M 0 0 L 4 3.5 L 0 7 Z"
                                    Fill="White"
                                    Margin="10,0,4,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"/>

                                <Path x:Name="downArrow"
                                      Grid.Column="3"
                                      Data="M 0 0 L 3 3 L 6 0 Z"
                                      VerticalAlignment="Center" 
                                      Margin="-2,2,4,0" 
                                      Fill="White" 
                                      Visibility="Collapsed"/>

                            </Grid>

                            <Popup x:Name="PART_Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                PopupAnimation="{DynamicResource {x:Static SystemParameters.MenuPopupAnimationKey}}"
                                IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">

                                <Border Background="#FF4F4F4F"
                                    BorderBrush="#FF6F6F6F"
                                    BorderThickness="1"
                                    Padding="4,2,4,4"
                                    Margin="0,0,8,8">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="5" BlurRadius="7" Color="Black" Opacity="0.45" />
                                    </Border.Effect>
                                    <ScrollViewer Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                                        <Grid RenderOptions.ClearTypeHint="Enabled">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                KeyboardNavigation.TabNavigation="Cycle"
                                                Grid.IsSharedSizeScope="True"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>

                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter Property="Padding" Value="7,2"/>
                            <Setter TargetName="Icon" Property="Margin" Value="2,2,-2,2"/>
                            <Setter TargetName="downArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                        </Trigger>

                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="rightArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                            <Setter Property="Background" Value="{StaticResource mnuDarkBackground}"/>
                        </Trigger>

                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="IconColumn" Property="Width" Value="0"/>
                        </Trigger>

                        <Trigger Property="Role" Value="SubmenuItem">
                            <Setter Property="Background" Value="{StaticResource mnuDarkBackground}"/>
                            <Setter Property="Padding" Value="0,3"/>
                        </Trigger>

                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="templateRoot" Property="Background" Value="#FF5F5F5F"/>
                            <Setter TargetName="templateRoot" Property="BorderBrush" Value="LightSkyBlue"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Dark mode Separator Style for menus and submenus containing no icons. 
         Note: To be applied in combination with above DarkModeMenuStyle -->
    
    <Style x:Key="DarkMenuNoIconsSeparatorStyle" TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="7"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="{StaticResource mnuDarkBackground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuIcon"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Separator line spans all columns -->
                        <Border Grid.ColumnSpan="4"
                                Height="1" 
                                Background="#FFA0A0A0"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <!-- Dark Mode ComboBox Style -->
    <!--==========================-->

    <!-- Color definitions -->

    <SolidColorBrush x:Key="cboForeground" Color="WhiteSmoke"/>
    <SolidColorBrush x:Key="cboBackground" Color="#FF4A4A4A"/>
    <SolidColorBrush x:Key="cboBorderBrush" Color="#FF8FC4F8"/>
    <SolidColorBrush x:Key="cboDropDownArrowBrush" Color="WhiteSmoke"/>

    <!-- Mouseover colors -->
    <SolidColorBrush x:Key="cboHoverBackground" Color="#FF50819C"/>
    <SolidColorBrush x:Key="cboHoverBorderBrush" Color="#FFB0D4F8"/>
    
    <SolidColorBrush x:Key="cboItemHighlightForeground" Color="White"/>
    <SolidColorBrush x:Key="cboItemHighlightBackground" Color="#FF444444"/>
    <SolidColorBrush x:Key="cboItemHighlightBorderBrush" Color="LightBlue"/>

    <SolidColorBrush x:Key="cboItemSelectedForeground" Color="LightSkyBlue"/>
    <SolidColorBrush x:Key="cboItemSelectedBackground" Color="#FF545454"/>

    <SolidColorBrush x:Key="cboDropDownBackground" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="cboDropDownBorderBrush" Color="gray"/> 


    <!-- ToggleButton Template for ComboBox (substyle) -->

    <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
        <Grid>
            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1"/>
            <Path x:Name="Arrow" HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" 
                Fill="{DynamicResource cboDropDownArrowBrush}"/>
        </Grid>
    </ControlTemplate>


    <!-- ── Dark ComboBox Style ──────────────────────────────────────────────────────
      
    The ToggleButton covers the entire control and drives IsDropDownOpen
      via a two-way binding so the dropdown actually opens on click.
      The ContentPresenter sits on top with IsHitTestVisible="False" so
      it never swallows the click meant for the ToggleButton.         -->
    
    <ControlTemplate x:Key="DarkComboTemplate" TargetType="ComboBox">
        
        <Grid>
            <!-- Full-area toggle that opens / closes the dropdown -->
            <ToggleButton Focusable="False"
                       ClickMode="Press"
                       BorderBrush="{TemplateBinding BorderBrush}"
                       BorderThickness="{TemplateBinding BorderThickness}"
                       Foreground="{TemplateBinding Foreground}"
                       Background="{TemplateBinding Background}"
                       IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                   RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="TBd"
                             Background="{TemplateBinding Background}"
                             BorderBrush="{TemplateBinding BorderBrush}"
                             BorderThickness="{TemplateBinding BorderThickness}"
                             CornerRadius="5">
                            <!-- Arrow chevron aligned to the right -->
                            <TextBlock Text="▾"
                                    Foreground="{TemplateBinding Foreground}" FontSize="14"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TBd" Property="BorderBrush" Value="#4A5090"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TBd" Property="BorderBrush" Value="#6878C8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <!-- Selected-item text; non-interactive so clicks pass through -->
            <ContentPresenter x:Name="SelectionContent"
                           Content="{TemplateBinding SelectionBoxItem}"
                           ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                           Margin="7,3,19,5"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>

            <!-- Fallback text shown via Tag when no item is selected
                 (e.g. a live zoom percentage that doesn't match a preset) -->
            <ContentPresenter x:Name="TagContent"
                           Content="{TemplateBinding Tag}"
                           Margin="7,3,19,5"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>

            <!-- Dropdown list -->
            <Popup x:Name="PART_Popup"
                IsOpen="{TemplateBinding IsDropDownOpen}"
                AllowsTransparency="True"
                Placement="Bottom"
                StaysOpen="False">
                <Border Background="#141430"
                     BorderBrush="#2E2E58"
                     BorderThickness="1"
                     CornerRadius="0,0,5,5"
                     MinWidth="{Binding ActualWidth,
                                RelativeSource={RelativeSource AncestorType=ComboBox}}">
                    <ScrollViewer MaxHeight="240"
                               VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="SelectedIndex" Value="-1">
                <Setter TargetName="SelectionContent" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="TagContent" Property="Visibility" Value="Visible"/>
            </Trigger>
        </ControlTemplate.Triggers>

    </ControlTemplate>

    <Style x:Key="DarkCombo" TargetType="ComboBox">
        <Setter Property="Background"    Value="#141430"/>
        <Setter Property="Foreground"    Value="#FFBAC5DA"/>
        <Setter Property="FontSize"      Value="12"/>
        <Setter Property="BorderBrush"   Value="#FFA6B4F8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template"      Value="{StaticResource DarkComboTemplate}"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground"  Value="#B0C4E8"/>
                    <Setter Property="Background"  Value="Transparent"/>
                    <Setter Property="Padding"     Value="4,5"/>
                    <Setter Property="FontSize"    Value="12"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#1E2050"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>



    <!-- Dark Mode ScrollViewer Style -->
    <!--==============================-->


    <!-- ScrollBar Colors -->
    
    <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#FF686868"/>
    <SolidColorBrush x:Key="ScrollBarThumbBackgroundHover" Color="#FF909090"/>
    <SolidColorBrush x:Key="ScrollBarThumbBackgroundDragging" Color="#FFB0B0B0"/>

   
    <!-- ScrollBar Style (sub-style) -->
    
    <Style x:Key="DarkScrollBarStyle" TargetType="{x:Type ScrollBar}">

        <!--Reduce width and height of scrollbars-->   
        <Style.Resources>
            <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">10</sys:Double>
            <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">10</sys:Double>
        </Style.Resources>

        <Setter Property="Background" Value="{StaticResource ScrollBarBackground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">

                    <Grid x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                        <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                            <Track.Thumb>

                                <Thumb>
                                    <Thumb.Style>
                                        <Style TargetType="{x:Type Thumb}">
                                            <Setter Property="Background" Value="{StaticResource ScrollBarThumbBackground}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Rectangle Fill="{TemplateBinding Background}" RadiusX="3" RadiusY="3"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="true">
                                                    <Setter Property="Background" Value="{StaticResource ScrollBarThumbBackgroundHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="true">
                                                    <Setter Property="Background" Value="{StaticResource ScrollBarThumbBackgroundDragging}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Thumb.Style>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!--Corrects the scroll direction reverse for horizontal scrollbars-->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- *** Dark ScrollViewer Style *** -->

    <ControlTemplate x:Key="DarkScrollViewerTemplate" TargetType="{x:Type ScrollViewer}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Content Presenter -->
            <ScrollContentPresenter Grid.Column="0" Grid.Row="0"/>

            <!-- Vertical ScrollBar -->
            <ScrollBar x:Name="PART_VerticalScrollBar"
                    Style="{StaticResource DarkScrollBarStyle}"
                    Grid.Column="1" Grid.Row="0"
                    Orientation="Vertical"
                    Maximum="{TemplateBinding ScrollableHeight}"
                    ViewportSize="{TemplateBinding ViewportHeight}"
                    Value="{TemplateBinding VerticalOffset}"
                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>

            <!-- Horizontal ScrollBar -->
            <ScrollBar x:Name="PART_HorizontalScrollBar"
                    Style="{StaticResource DarkScrollBarStyle}"
                    Grid.Column="0" Grid.Row="1"
                    Orientation="Horizontal"
                    Maximum="{TemplateBinding ScrollableWidth}"
                    ViewportSize="{TemplateBinding ViewportWidth}"
                    Value="{TemplateBinding HorizontalOffset}"
                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
        </Grid>
    </ControlTemplate>

    <Style x:Key="DarkScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
        <Setter Property="Template" Value="{StaticResource DarkScrollViewerTemplate}"/>
    </Style>


    <!-- *** Skin-following ScrollViewer Style (follows the active app skin) *** -->
    <!--Structurally identical to DarkScrollBarStyle/DarkScrollViewerTemplate above, but the thumb brushes
        are DynamicResource skin keys (ScrollThumbBackground*) instead of the fixed dark ones, so the same
        flat scrollbar renders in both themes. Kept as a separate copy rather than repointing the Dark*
        resources, since DarkScrollViewerStyle is also used explicitly, unconditionally, by panels that are
        always dark regardless of app theme (SequenceGraph, dlgConnectGraph, dlgSearch, SequenceSchemeView) —
        those must NOT follow the skin swap.-->

    <Style x:Key="SkinScrollBarStyle" TargetType="{x:Type ScrollBar}">

        <!--Reduce width and height of scrollbars-->
        <Style.Resources>
            <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">10</sys:Double>
            <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarHeightKey}">10</sys:Double>
        </Style.Resources>

        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">

                    <Grid x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                        <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                            <Track.Thumb>

                                <Thumb>
                                    <Thumb.Style>
                                        <Style TargetType="{x:Type Thumb}">
                                            <Setter Property="Background" Value="{DynamicResource ScrollThumbBackground}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Rectangle Fill="{TemplateBinding Background}" RadiusX="3" RadiusY="3"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="true">
                                                    <Setter Property="Background" Value="{DynamicResource ScrollThumbBackgroundHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="true">
                                                    <Setter Property="Background" Value="{DynamicResource ScrollThumbBackgroundDragging}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Thumb.Style>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!--Corrects the scroll direction reverse for horizontal scrollbars-->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="SkinScrollViewerTemplate" TargetType="{x:Type ScrollViewer}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Content Presenter -->
            <ScrollContentPresenter Grid.Column="0" Grid.Row="0"/>

            <!-- Vertical ScrollBar -->
            <ScrollBar x:Name="PART_VerticalScrollBar"
                    Style="{StaticResource SkinScrollBarStyle}"
                    Grid.Column="1" Grid.Row="0"
                    Orientation="Vertical"
                    Maximum="{TemplateBinding ScrollableHeight}"
                    ViewportSize="{TemplateBinding ViewportHeight}"
                    Value="{TemplateBinding VerticalOffset}"
                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>

            <!-- Horizontal ScrollBar -->
            <ScrollBar x:Name="PART_HorizontalScrollBar"
                    Style="{StaticResource SkinScrollBarStyle}"
                    Grid.Column="0" Grid.Row="1"
                    Orientation="Horizontal"
                    Maximum="{TemplateBinding ScrollableWidth}"
                    ViewportSize="{TemplateBinding ViewportWidth}"
                    Value="{TemplateBinding HorizontalOffset}"
                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
        </Grid>
    </ControlTemplate>

    <Style x:Key="SkinScrollViewerStyle" TargetType="{x:Type ScrollViewer}">
        <Setter Property="Template" Value="{StaticResource SkinScrollViewerTemplate}"/>
    </Style>


    <!--Applies the unified flat scrollbar app-wide to any ScrollViewer (including ones inside a
        control's default template, e.g. TreeView/ListBox), unconditionally in both themes — the thumb
        color follows the active skin via DynamicResource, so no trigger is needed here.
        Controls that are always dark regardless of mode keep using DarkScrollViewerStyle/-Template
        explicitly instead (see comment above).-->

    <Style TargetType="{x:Type ScrollViewer}">
        <Setter Property="Template" Value="{StaticResource SkinScrollViewerTemplate}"/>
    </Style>


    <!-- Dark Mode Button Style -->
    <!--==============================-->

    <Style x:Key="DarkModeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#353560"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#2D2D60"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>
